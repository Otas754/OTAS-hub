const generateMockFinancialData = (years: number) => {
    const data = [];
    let revenue = 100;
    let expenses = 80;
    let assets = 500;
    let liabilities = 200;
    let stockPrice = 50;

    for (let i = 0; i < years; i++) {
        const year = new Date().getFullYear() - years + i + 1;
        revenue *= (1 + Math.random() * 0.1); // Simulate growth
        expenses *= (1 + Math.random() * 0.08);
        const profit = revenue - expenses;
        assets *= (1 + Math.random() * 0.05);
        liabilities *= (1 + Math.random() * 0.07);
        const equity = assets - liabilities;
        stockPrice *= (1 + Math.random() * 0.15 - 0.05); // Simulate stock price fluctuation
        data.push({
            year: year.toString(),
            revenue: Math.round(revenue),
            expenses: Math.round(expenses),
            profit: Math.round(profit),
            assets: Math.round(assets),
            liabilities: Math.round(liabilities),
            equity: Math.round(equity),
            stockPrice: parseFloat(stockPrice.toFixed(2)),
            debtToEquityRatio: parseFloat((liabilities / equity).toFixed(2)),
            returnOnEquity: parseFloat((profit / equity).toFixed(2)),
        });
    }
    return data;
};

